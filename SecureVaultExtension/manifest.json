{
  "manifest_version": 3,
  "name": "SecureVault",
  "version": "1.0.2",
  "description": "Suggest save and autofill passwords using SecureVault Application",

  "permissions": ["nativeMessaging", "activeTab", "scripting"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}
