    color: white;
	font-size: 20px;
    font-weight: bold;
	border-radius: 8px;
}
#loginButton:hover {
    background-color: rgb(59, 130, 246);
}

#createAccountButton {
    background: transparent;
    border: none;
    padding: 0;
    color: rgb(153, 235, 255);   
    font-weight: normal;
}

#createAccountButton:hover {
    text-decoration: underline;
}

#createAccountButton:pressed {
    color: #005a9e;
}

#loginCard {
